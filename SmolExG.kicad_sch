	)
	(text "AC coupling because we don't want to do RLD.\nSee: https://www.ti.com/video/series/how-to-measure-ecg--a-guide-to-the-signals--system-blocks-and-so.html\n\nLow-pass RC filter (for antialiasing) -\nR=20kR, C=1nF\nCutoff 1/(2*PI*R*C) = ~800 Hz\n\nDC blocking -\nR=500kR, C=10uF\nCutoff = ~0.03 Hz"
		(exclude_from_sim no)
		(at 20.828 129.54 0)
		(effects
			(font
				(size 0.75 0.75)
			)
			(justify left)
		)
		(uuid "ff74364f-2e98-46d7-86a9-c43d4129c4e8")
